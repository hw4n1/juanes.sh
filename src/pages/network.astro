---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtlasProbe from '../components/AtlasProbe.astro';
import OoniNetwork from '../components/OoniNetwork.astro';
import RackStatus from '../components/RackStatus.astro';
---

<BaseLayout
  title="Network"
  description="Public services running from my home rack in Colombia: Arch Linux and Debian mirrors, a Tor relay, an NTP Pool server, a RIPE Atlas probe and OONI Probe."
  canonicalURL={new URL('/network/', Astro.site)}
>
  <div class="page">
    <header class="page-header measure">
      <p class="prompt-prefix" aria-hidden="true">$ cat network.md</p>
      <h1>Network</h1>
      <p class="lead">
        Infrastructure I run that other people depend on, not just me. Nothing here is a claim about my skills —
        it's capacity handed to public networks, and it can be verified from the outside.
      </p>
      <p class="body">
        It all lives in a rack at home: package mirrors for Arch Linux and Debian, a <strong>Tor relay</strong>, a
        stratum-1 time server in the <strong>NTP Pool</strong>, and two measurement probes. The live, per-minute view
        is at <a href="https://status.naing.co" rel="noopener">status.naing.co</a>; below is the snapshot from the
        last build.
      </p>
    </header>

    <div class="panels">
      <RackStatus />
      <AtlasProbe probeId={1016413} />
      <OoniNetwork asn="AS3816" cc="CO" />
    </div>

    <p class="freshness measure">
      All figures on this page are resolved at build time — no client-side JavaScript, no third-party widgets, no
      requests leaving your browser. The site rebuilds once a day, so readings can be up to 24 hours old.
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 56rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
  }

  .prompt-prefix {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .lead {
    margin-top: 1.1rem;
    font-size: var(--text-lg);
    color: var(--ink-700);
  }

  .body {
    margin-top: 1.1rem;
    color: var(--ink-900);
    line-height: 1.7;
  }

  .body a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .panels {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  .panels > :global(section) {
    border-top: 1px solid var(--border);
    padding-block: 1.75rem;
  }

  .freshness {
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--ink-500);
  }
</style>
