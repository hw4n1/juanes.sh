---
import BaseLayout from '../layouts/BaseLayout.astro';
import TagPill from '../components/TagPill.astro';
import { SOCIAL_LINKS, CV_URL } from '../consts';

const expertise = ['appsec', 'devsecops', 'bug-bounty', 'pentesting', 'kernel', 'networking', 'tor', 'homelab'];

// The lore: what happened, told the way it felt. The boring version is in the CV.
const lore = [
  {
    when: '2026 – now',
    title: 'Cartographer of a labyrinth nobody drew',
    story:
      'Dropped into a legacy ASP.NET kingdom with 1,500+ doors and no map. Drew the map. Then knocked on every door to ask whether it should really open for this person. More than fifteen of them, it turned out, should not have — so I stayed until each one was locked and checked the lock myself.',
    actually:
      'Security Engineer at B2Gnow (via Insight Global): vulnerability lifecycle from manual pentesting to verified fix, mostly IDOR and privilege escalation.',
  },
  {
    when: '2026',
    title: 'Closing bugs from 2004',
    story:
      "Someone asked Debian's adduser in 2004 to stop handing a dead account's user id to a new one. Someone else asked it in 2007 to install SSH keys for new users. Both requests waited patiently for about two decades. Then I showed up, read some Perl, and they shipped.",
    actually: 'Two patches merged upstream into Debian adduser, released in 3.159 and 3.160.',
    link: { href: '/projects/#upstream', text: 'details on /projects' },
  },
  {
    when: '2026 – 2027',
    title: 'Interrogating kernels with math',
    story:
      'Asking a Linux kernel, politely and with entropy, whether something is hiding inside it. To understand the liars, I also write the liars: kernel modules that hook syscalls and whisper through Netfilter. For science.',
    actually: 'M.S. in Information Security at Universidad de los Andes. Thesis: rootkit detection via information theory.',
  },
  {
    when: '2025 – 2026',
    title: 'Robot whisperer',
    story:
      'Taught small robots to tap phones, click websites and poke APIs until 90% of the important buttons were pressed without a human. The robots never asked why. I respected that.',
    actually: 'Test Automation Engineer at Globant (TypeScript, Python, GitLab CI/CD).',
  },
  {
    when: '2022 – 2025',
    title: 'Survived Operating Systems, then taught it',
    story:
      'Studied systems engineering, then went back to teach OS, data structures and advanced programming to people going through what I had just gone through. Also helped run a student branch that ended up the best in the country.',
    actually: 'B.S. in Systems Engineering, Pontificia Universidad Javeriana. TA, and Vice-Chair of IEEE Javeriana.',
  },
];

// Things running right now that no one asked for.
const unrequested = [
  ['Two package mirrors', 'Arch Linux and Debian, synced around the clock, ~1 TB of other people’s updates.'],
  ['The time', 'A stratum-1 NTP server in the public pool, telling South America what time it is a few thousand times per second.'],
  ['A Tor relay', 'Forwarding strangers’ traffic without knowing who they are. That’s the whole idea.'],
  ['Two probes', 'RIPE Atlas measuring the internet and OONI measuring censorship in Colombia.'],
  [
    'A cluster with a Raspberry Pi as tiebreaker',
    'Two Proxmox nodes that couldn’t agree on anything, so a Pi now casts the deciding vote.',
  ],
  [
    'Two internet connections',
    'Dual WAN with failover and a static /29, because the rack does not accept "the ISP is down" as an excuse.',
  ],
  ['VLANs on a MikroTik', 'Segmented, because one flat network is how horror movies start. Slowly turning into Ansible and Terraform.'],
  ['Honeypots', 'Cowrie, Dionaea and Conpot pretending to be vulnerable, feeding MISP and Wazuh with whoever falls for it.'],
];

const achievements = [
  '1st place in Colombia — IEEEXtreme 18 (2024). 24 hours of programming, zero hours of sleep.',
  '2nd place — CyberWings, the Colombian Air Force cybersecurity competition. No planes were involved.',
  'Judge at the VEX Robotics World Championship in Dallas. Robots were, again, involved.',
  'Founded chapters and led technical teams of 30+ people at IEEE Javeriana and IEEE Uniandes.',
  '100th percentile nationally on the Saber 11 exam. Peaked at seventeen, still coasting.',
  'Paperwork that says I know things: eJPT, ISC2 CC, INE CCA, Google Cloud Digital Leader.',
];
---

<BaseLayout
  title="About"
  description="Juan Esteban Muñoz Díaz (Juanes): security engineer building things the universe didn't ask for — Debian patches, a home rack of public mirrors, a Tor relay, an NTP server and a kernel thesis."
  canonicalURL={new URL('/about/', Astro.site)}
>
  <article class="about measure">
    <header>
      <p class="prompt-prefix" aria-hidden="true">$ cat about.md</p>
      <h1>Juan Esteban Muñoz Díaz</h1>
      <p class="subtitle">"Juanes" · security engineer · building things the universe didn't ask for</p>
    </header>

    <section>
      <p>
        I break things professionally so they don't break by accident. Officially that's called vulnerability
        response. Unofficially, it's a habit of opening every door to see what's behind it, then refusing to leave
        until someone fixes the lock. I speak Spanish, English, French, C, Python, Go, Bash and, recently, Perl.
      </p>
      <p>
        The rest of the time I run a small rack at home that quietly serves the internet things it never asked
        for: Linux mirrors, the time, Tor traffic. It's monitored live at{' '}
        <a href="https://status.naing.co" rel="noopener">status.naing.co</a> and summarised on{' '}
        <a href="/network/">/network</a>.
      </p>
    </section>

    <section>
      <h2>$ cat lore.md</h2>
      <ol class="lore">
        {
          lore.map((entry) => (
            <li class="chapter">
              <p class="when">{entry.when}</p>
              <h3>{entry.title}</h3>
              <p class="story">{entry.story}</p>
              <p class="actually">
                <span class="actually-label">translation:</span> {entry.actually}
                {entry.link && (
                  <>
                    {' '}
                    <a href={entry.link.href}>{entry.link.text}</a>
                  </>
                )}
              </p>
            </li>
          ))
        }
      </ol>
      <p class="boring">
        Prefer the version with bullet points and verbs like "leveraged"?{' '}
        <a href={CV_URL} target="_blank" rel="noopener">↓ the serious CV (PDF)</a>
      </p>
    </section>

    <section>
      <h2>$ ls ~/things-nobody-asked-for/</h2>
      <dl class="unrequested">
        {
          unrequested.map(([what, why]) => (
            <div>
              <dt>{what}</dt>
              <dd>{why}</dd>
            </div>
          ))
        }
      </dl>
      <p class="muted small">
        The cluster story, including the vote that wouldn't happen, is{' '}
        <a href="/blog/the-qdevice-that-wouldnt-vote/">in the blog</a>. I also keep a weekly streak on Hack The Box,
        which is the gym, but for breaking into things legally.
      </p>
    </section>

    <section>
      <h2>$ cat achievements.unlocked</h2>
      <ul class="recognition-list">
        {achievements.map((a) => <li>{a}</li>)}
      </ul>
    </section>

    <section>
      <h2>$ ls known-side-effects/</h2>
      <ul class="expertise-list">
        {expertise.map((tag) => <li><TagPill tag={tag} static /></li>)}
      </ul>
    </section>

    <section>
      <h2>$ cat talks.md</h2>
      <p class="muted">
        No public talks yet. The plan is DEF CON. The universe has not been consulted, as usual.
      </p>
    </section>

    <section>
      <h2>$ cat contact.md</h2>
      <ul class="contact-list">
        {
          SOCIAL_LINKS.map((link) => (
            <li>
              <a href={link.url} rel="me noopener noreferrer" target="_blank">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .about {
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
  }

  .prompt-prefix {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-500);
    margin-top: 0.6rem;
  }

  section {
    margin-top: 2.4rem;
  }

  section > p + p {
    margin-top: 1rem;
  }

  section h2 {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--ink-700);
    margin-bottom: 0.75rem;
  }

  section h3 {
    font-size: var(--text-lg);
  }

  section p {
    color: var(--ink-900);
    line-height: 1.7;
  }

  section a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .muted {
    color: var(--ink-500);
  }

  .small {
    margin-top: 1.25rem;
    font-size: var(--text-sm);
  }

  .lore {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .chapter {
    border-left: 2px solid var(--border);
    padding-left: 1.1rem;
  }

  .when {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-500);
  }

  .chapter h3 {
    margin-top: 0.2rem;
  }

  .story {
    margin-top: 0.5rem;
  }

  .actually {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-700);
  }

  .actually-label {
    color: var(--accent);
  }

  .boring {
    margin-top: 2rem;
    font-size: var(--text-sm);
    color: var(--ink-700);
  }

  .boring a {
    font-family: var(--font-mono);
  }

  .unrequested {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 0;
  }

  .unrequested dt {
    font-weight: 600;
    color: var(--ink-900);
  }

  .unrequested dd {
    margin: 0.15rem 0 0;
    color: var(--ink-700);
    line-height: 1.6;
  }

  .expertise-list,
  .contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
  }

  .contact-list {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .recognition-list {
    margin-top: 1rem;
    padding-left: 1.3em;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    color: var(--ink-900);
    line-height: 1.7;
  }
</style>
